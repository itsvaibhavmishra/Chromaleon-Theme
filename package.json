        "uiTheme": "vs"
      }
    ],
    "iconThemes": [
      {
        "id": "chromaleon-icons",
        "label": "Chromaleon Icons",
        "path": "./themes/Chromaleon-Icons.json",
        "_watch": true
      }
    ]
  },
  "galleryBanner": {
    "color": "#111113",
    "theme": "dark"
  }
}
